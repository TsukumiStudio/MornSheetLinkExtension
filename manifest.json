{
  "manifest_version": 3,
  "name": "Morn Sheet Link Extension",
  "version": "0.1.3",
  "description": "Google スプレッドシートの選択範囲を、ハイパーリンクとしてコピー。",
  "permissions": [
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/spreadsheets/d/*",
        "https://docs.google.com/spreadsheets/u/*/d/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
