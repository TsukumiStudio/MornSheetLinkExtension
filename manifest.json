{
  "manifest_version": 3,
  "name": "Morn Sheet Link Extension",
  "version": "0.1.2",
  "description": "選択範囲へのリンクを、ファイル名_タブ名_範囲のハイパーテキストとしてコピーします。",
  "permissions": ["clipboardWrite"],
  "content_scripts": [{
    "matches": [
      "https://docs.google.com/spreadsheets/d/*",
      "https://docs.google.com/spreadsheets/u/*/d/*"
    ],
    "js": ["content.js"],
    "css": ["content.css"]
  }]
}
